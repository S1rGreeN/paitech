# Desarrollo local con SQLite
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TRUST_X_FORWARDED_FOR=False

# Déjalo vacío para usar SQLite local.
# En Vercel pega la URL con pooling de PostgreSQL entregada por Neon.
DATABASE_URL=

# Solo para el cron de Vercel. Genera un secreto distinto de SECRET_KEY y
# configúralo manualmente en Vercel; no es una credencial para Android.
CRON_SECRET=
SENSORES_HABILITADOS=False

# Para comandos manuales con otro archivo privado (por ejemplo .env.neon.local),
# define PAIPAY_ENV_FILE en tu terminal. Consulta DESPLIEGUE_VERCEL.md.

# Déjalo en 0 durante el primer despliegue. Actívalo cuando el dominio y HTTPS
# estén confirmados; por ejemplo 31536000 para un año.
SECURE_HSTS_SECONDS=0
