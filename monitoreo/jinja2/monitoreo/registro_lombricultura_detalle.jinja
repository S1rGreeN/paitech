{% extends "monitoreo/base.jinja" %}
{% block title %}Registro de lombricultura · PaiPayTech{% endblock %}
{% block content %}
<section class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <a href="{{ url('monitoreo:cama_detalle', cama_id=registro.cama_id) }}" class="text-sm font-bold text-stone-500">← Volver a la cama</a>
    <article class="mt-5 rounded-[2rem] border border-stone-200 bg-white p-7 brand-shadow sm:p-9">
        <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-black uppercase tracking-wider text-amber-800">Ciclo {{ registro.ciclo.numero }}</span>
        <h1 class="mt-4 text-3xl font-black text-brand-brown">Registro de {{ registro.cama.nombre }}</h1>
        <p class="mt-2 text-stone-500">{{ registro.capturada_en.strftime('%d/%m/%Y %H:%M') }} · {{ registro.autor.nickname }}</p>
        <div class="mt-7 grid gap-4 sm:grid-cols-2">
            <div class="rounded-3xl bg-lime-50 p-6"><p class="text-sm text-stone-500">pH del suelo</p><p class="mt-2 text-4xl font-black text-brand-brown">{{ registro.ph_suelo }}</p></div>
            <div class="rounded-3xl bg-amber-50 p-6"><p class="text-sm text-stone-500">Conteo observado</p><p class="mt-2 text-4xl font-black text-brand-brown">{{ registro.conteo_lombrices }}</p></div>
        </div>
        <div class="mt-6"><p class="text-sm font-bold text-stone-500">Observaciones</p><p class="mt-2 whitespace-pre-wrap text-stone-700">{{ registro.observaciones or 'Sin observaciones.' }}</p></div>
        <p class="mt-6 text-xs text-stone-400">Versión {{ registro.version }} · {{ registro.estado }}</p>
    </article>
</section>
{% endblock %}
