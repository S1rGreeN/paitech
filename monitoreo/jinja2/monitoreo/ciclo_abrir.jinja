{% extends "monitoreo/base.jinja" %}

{% block title %}Iniciar ciclo · {{ piscina.nombre }}{% endblock %}

{% block content %}
<section class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
    <a href="{{ url('monitoreo:piscina_detalle', piscina_id=piscina.id) }}" class="text-sm font-bold text-stone-500">← Volver a la piscina</a>
    <div class="mt-5 rounded-[2rem] border border-stone-200 bg-white p-6 brand-shadow sm:p-9">
        <p class="text-sm font-black uppercase tracking-[0.16em] text-brand-green">{{ piscina.codigo }} · {{ piscina.especie.nombre_comun }}</p>
        <h1 class="mt-3 text-3xl font-black text-brand-brown">Iniciar ciclo productivo</h1>
        <p class="mt-3 leading-7 text-stone-600">El ciclo comienza con la siembra completa. Ventas o traslados parciales se registran luego como movimientos excepcionales.</p>

        {% if form.non_field_errors() %}<div class="mt-5 rounded-2xl bg-red-50 p-4 text-sm text-red-700">{% for error in form.non_field_errors() %}<p>{{ error }}</p>{% endfor %}</div>{% endif %}
        <form method="post" class="mt-7 space-y-5" novalidate>
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            {% for field in form %}
            <div>
                <label for="{{ field.id_for_label }}" class="text-sm font-bold text-brand-brown">{{ field.label }}</label>
                {{ field }}
                {% for error in field.errors %}<p class="mt-2 text-sm text-red-700">{{ error }}</p>{% endfor %}
            </div>
            {% endfor %}

            {% if prediccion %}
            <div class="rounded-3xl border border-brand-green/30 bg-lime-50 p-5">
                <p class="text-xs font-black uppercase tracking-wider text-brand-green">Estimación estadística</p>
                {% if prediccion.prediccion_poblacion_final is not none %}
                <p class="mt-2 text-3xl font-black text-brand-brown">{{ prediccion.prediccion_poblacion_final }} peces</p>
                <p class="mt-2 text-sm text-stone-600">Rango histórico: {{ prediccion.prediccion_min }}–{{ prediccion.prediccion_max }} · {{ prediccion.prediccion_ciclos_usados }} ciclos · confianza {{ prediccion.prediccion_confianza|lower|replace('_', ' ') }}.</p>
                {% else %}
                <p class="mt-2 font-bold text-brand-brown">Todavía no hay ciclos cerrados comparables en esta piscina.</p>
                <p class="mt-1 text-sm text-stone-600">El ciclo puede iniciarse, pero no se mostrará una cifra sin evidencia.</p>
                {% endif %}
                <p class="mt-3 text-xs text-stone-500">Esta predicción es orientativa, no garantiza el resultado biológico.</p>
            </div>
            {% endif %}

            <div class="flex flex-col-reverse gap-3 border-t border-stone-100 pt-6 sm:flex-row sm:justify-end">
                <button type="submit" name="previsualizar" value="1" class="rounded-2xl border border-brand-green px-5 py-3 font-bold text-brand-brown">Calcular estimación</button>
                {% if prediccion %}<button type="submit" name="confirmar" value="1" class="rounded-2xl bg-brand-brown px-6 py-3 font-bold text-white">Confirmar e iniciar</button>{% endif %}
            </div>
        </form>
    </div>
</section>
{% endblock %}
