{% extends "monitoreo/base.jinja" %}

{% block title %}Nueva jornada · {{ piscina.nombre }}{% endblock %}

{% macro field_errors(field) %}
    {% for error in field.errors %}<p class="mt-2 text-sm font-medium text-red-700">{{ error }}</p>{% endfor %}
{% endmacro %}

{% block content %}
<section class="mx-auto max-w-5xl px-4 pt-8 sm:px-6 lg:px-8">
    <a href="{{ url('monitoreo:piscina_detalle', piscina_id=piscina.id) }}" class="text-sm font-bold text-stone-500 hover:text-brand-brown">← Volver a {{ piscina.nombre }}</a>
    <div class="mt-5 rounded-[2rem] border border-stone-200 bg-white p-6 brand-shadow sm:p-9">
        <span class="rounded-full bg-brand-green/15 px-3 py-1 text-xs font-black uppercase tracking-[0.16em] text-brand-brown">{{ piscina.codigo }}</span>
        <h1 class="mt-4 text-3xl font-black text-brand-brown">Nueva jornada de registro</h1>
        <p class="mt-2 text-stone-500">Ciclo {{ ciclo.numero }} · especie permanente: <strong>{{ piscina.especie.nombre_comun }}</strong>. Puedes registrar solo agua, solo biometría o ambos bloques.</p>

        {% if form.non_field_errors() or formset.non_form_errors() %}
        <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            {% for error in form.non_field_errors() %}<p>{{ error }}</p>{% endfor %}
            {% for error in formset.non_form_errors() %}<p>{{ error }}</p>{% endfor %}
        </div>
        {% endif %}

        <form method="post" class="mt-8" novalidate>
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            {{ formset.management_form }}

            <section class="grid gap-5 sm:grid-cols-2">
                <div>
                    <label for="{{ form.capturada_en.id_for_label }}" class="text-sm font-bold text-brand-brown">{{ form.capturada_en.label }}</label>
                    {{ form.capturada_en }}{{ field_errors(form.capturada_en) }}
                </div>
                <div>
                    <label for="{{ form.poblacion_estimada.id_for_label }}" class="text-sm font-bold text-brand-brown">{{ form.poblacion_estimada.label }}</label>
                    {{ form.poblacion_estimada }}{{ field_errors(form.poblacion_estimada) }}
                </div>
                <div class="sm:col-span-2">
                    <label for="{{ form.observaciones.id_for_label }}" class="text-sm font-bold text-brand-brown">{{ form.observaciones.label }}</label>
                    {{ form.observaciones }}{{ field_errors(form.observaciones) }}
                </div>
            </section>

            <section class="mt-9 border-t border-stone-100 pt-8">
                <label class="flex items-center gap-3 font-black text-brand-brown">{{ form.registrar_agua }} {{ form.registrar_agua.label }}</label>
                <p class="mt-1 text-sm text-stone-500">Ingresa manualmente el valor obtenido. Se guarda un solo pH final aunque se utilicen las dos pruebas; nitrato, nitrito y amoníaco total se registran en ppm.</p>
                <div id="water-fields" class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                    {% for field in [form.ph, form.nitrato, form.nitrito, form.amoniaco_total] %}
                    <div><label for="{{ field.id_for_label }}" class="text-sm font-bold text-brand-brown">{{ field.label }}</label>{{ field }}{{ field_errors(field) }}</div>
                    {% endfor %}
                </div>
            </section>

            <section class="mt-9 border-t border-stone-100 pt-8">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <label class="flex items-center gap-3 font-black text-brand-brown">{{ form.registrar_biometria }} {{ form.registrar_biometria.label }}</label>
                        <p class="mt-1 text-sm text-stone-500">Una fila representa un pez anónimo de la muestra.</p>
                    </div>
                    <button type="button" id="add-sample" class="rounded-xl border border-brand-green/40 px-4 py-2.5 text-sm font-bold text-brand-brown hover:bg-lime-50">+ Agregar pez</button>
                </div>
                <div id="sample-forms" class="mt-6 space-y-4">
                    {% for sample_form in formset.forms %}
                    <article class="sample-form rounded-3xl border border-stone-200 bg-stone-50/70 p-5" data-form-index="{{ loop.index0 }}">
                        <div class="mb-4 flex items-center justify-between"><h3 class="sample-title font-black text-brand-brown">Pez {{ loop.index }}</h3><button type="button" class="remove-sample rounded-lg px-3 py-1 text-xs font-bold text-red-700">Quitar</button></div>
                        {% for error in sample_form.non_field_errors() %}<p class="mb-3 text-sm text-red-700">{{ error }}</p>{% endfor %}
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div><label for="{{ sample_form.peso_gramos.id_for_label }}" class="text-sm font-bold text-brand-brown">{{ sample_form.peso_gramos.label }}</label>{{ sample_form.peso_gramos }}{{ field_errors(sample_form.peso_gramos) }}</div>
                            <div><label for="{{ sample_form.talla_centimetros.id_for_label }}" class="text-sm font-bold text-brand-brown">{{ sample_form.talla_centimetros.label }}</label>{{ sample_form.talla_centimetros }}{{ field_errors(sample_form.talla_centimetros) }}</div>
                        </div>
                    </article>
                    {% endfor %}
                </div>
                <template id="empty-form-template">
                    <article class="sample-form rounded-3xl border border-stone-200 bg-stone-50/70 p-5" data-form-index="__prefix__">
                        <div class="mb-4 flex items-center justify-between"><h3 class="sample-title font-black text-brand-brown">Nuevo pez</h3><button type="button" class="remove-sample rounded-lg px-3 py-1 text-xs font-bold text-red-700">Quitar</button></div>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div><label for="{{ formset.empty_form.peso_gramos.id_for_label }}" class="text-sm font-bold text-brand-brown">{{ formset.empty_form.peso_gramos.label }}</label>{{ formset.empty_form.peso_gramos }}</div>
                            <div><label for="{{ formset.empty_form.talla_centimetros.id_for_label }}" class="text-sm font-bold text-brand-brown">{{ formset.empty_form.talla_centimetros.label }}</label>{{ formset.empty_form.talla_centimetros }}</div>
                        </div>
                    </article>
                </template>
            </section>

            <div class="mt-10 flex flex-col-reverse gap-3 border-t border-stone-100 pt-7 sm:flex-row sm:justify-end">
                <a href="{{ url('monitoreo:piscina_detalle', piscina_id=piscina.id) }}" class="rounded-2xl border border-stone-200 px-5 py-3 text-center font-bold text-stone-600">Cancelar</a>
                <button type="submit" class="rounded-2xl bg-brand-brown px-6 py-3 font-bold text-white">Guardar jornada</button>
            </div>
        </form>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script>
(() => {
    const container = document.getElementById('sample-forms');
    const totalInput = document.getElementById('id_muestras-TOTAL_FORMS');
    const template = document.getElementById('empty-form-template');
    const biometricToggle = document.getElementById('id_registrar_biometria');
    const waterToggle = document.getElementById('id_registrar_agua');
    const waterFields = document.getElementById('water-fields');
    const addButton = document.getElementById('add-sample');
    const maxForms = 500;

    function refresh() {
        [...container.querySelectorAll('.sample-form')].forEach((card, index) => card.querySelector('.sample-title').textContent = `Pez ${index + 1}`);
        container.classList.toggle('hidden', !biometricToggle.checked);
        addButton.classList.toggle('hidden', !biometricToggle.checked);
        waterFields.classList.toggle('hidden', !waterToggle.checked);
    }
    addButton.addEventListener('click', () => {
        const total = Number(totalInput.value);
        if (total >= maxForms) return;
        container.insertAdjacentHTML('beforeend', template.innerHTML.replaceAll('__prefix__', total));
        totalInput.value = total + 1;
        refresh();
    });
    container.addEventListener('click', (event) => {
        const button = event.target.closest('.remove-sample');
        if (!button) return;
        button.closest('.sample-form').remove();
        const remaining = [...container.querySelectorAll('.sample-form')];
        remaining.forEach((card, index) => {
            card.querySelectorAll('input, label').forEach((element) => {
                if (element.name) element.name = element.name.replace(/muestras-\d+-/g, `muestras-${index}-`);
                if (element.id) element.id = element.id.replace(/id_muestras-\d+-/g, `id_muestras-${index}-`);
                if (element.htmlFor) element.htmlFor = element.htmlFor.replace(/id_muestras-\d+-/g, `id_muestras-${index}-`);
            });
        });
        totalInput.value = remaining.length;
        refresh();
    });
    biometricToggle.addEventListener('change', refresh);
    waterToggle.addEventListener('change', refresh);
    refresh();
})();
</script>
{% endblock %}
