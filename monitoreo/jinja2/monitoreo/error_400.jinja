{% extends "monitoreo/base.jinja" %}

{% block title %}Solicitud no válida · PaiPayTech{% endblock %}

{% block content %}
<section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <div class="rounded-[2rem] border border-amber-200 bg-white p-8 text-center brand-shadow">
        <p class="text-sm font-black uppercase tracking-wider text-amber-700">Solicitud no válida</p>
        <h1 class="mt-3 text-3xl font-black text-brand-brown">No pudimos procesar esta petición</h1>
        <p class="mt-4 text-stone-600">Actualiza la página e inténtalo nuevamente. Si se repite, comparte únicamente este identificador con soporte:</p>
        <code class="mt-4 inline-block rounded-xl bg-stone-100 px-4 py-2 text-sm text-stone-700">{{ request_id }}</code>
    </div>
</section>
{% endblock %}
