{% extends "monitoreo/base.jinja" %}

{% block title %}Cambiar contraseña · PaiPayTech{% endblock %}

{% block content %}
<section class="soft-grid min-h-[calc(100vh-5rem)] px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-xl rounded-[2rem] border border-white/70 bg-white p-7 brand-shadow sm:p-10">
        <p class="text-sm font-bold uppercase tracking-[0.22em] text-brand-green">Protección de la cuenta</p>
        <h1 class="mt-2 text-3xl font-black tracking-tight text-brand-brown">Cambia la contraseña temporal</h1>
        <p class="mt-3 text-stone-600">Antes de continuar debes elegir una contraseña que solo tú conozcas. Al guardarla se cerrarán todas las sesiones abiertas.</p>

        {% if form.non_field_errors() %}
        <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            {% for error in form.non_field_errors() %}<p>{{ error }}</p>{% endfor %}
        </div>
        {% endif %}

        <form method="post" class="mt-7 space-y-5" novalidate>
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            {% for field in form %}
            <div>
                <label for="{{ field.id_for_label }}" class="text-sm font-bold text-brand-brown">{{ field.label }}</label>
                {{ field }}
                {% if field.help_text %}<p class="mt-2 text-sm text-stone-500">{{ field.help_text }}</p>{% endif %}
                {% for error in field.errors %}<p class="mt-2 text-sm text-red-700">{{ error }}</p>{% endfor %}
            </div>
            {% endfor %}
            <button type="submit" class="w-full rounded-2xl bg-brand-brown px-5 py-3.5 font-bold text-white shadow-lg transition hover:bg-[#35260f] focus:outline-none focus:ring-4 focus:ring-brand-green/30">
                Guardar y cerrar sesiones
            </button>
        </form>
    </div>
</section>
{% endblock %}
