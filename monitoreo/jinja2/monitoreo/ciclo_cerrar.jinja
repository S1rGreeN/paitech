{% extends "monitoreo/base.jinja" %}

{% block title %}Cerrar ciclo {{ ciclo.numero }} · {{ piscina.nombre }}{% endblock %}

{% block content %}
<section class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
    <a href="{{ url('monitoreo:piscina_detalle', piscina_id=piscina.id) }}" class="text-sm font-bold text-stone-500">← Volver a la piscina</a>
    <div class="mt-5 rounded-[2rem] border border-stone-200 bg-white p-6 brand-shadow sm:p-9">
        <p class="text-sm font-black uppercase tracking-[0.16em] text-brand-green">{{ piscina.codigo }} · ciclo {{ ciclo.numero }}</p>
        <h1 class="mt-3 text-3xl font-black text-brand-brown">Cerrar ciclo productivo</h1>
        <div class="mt-5 rounded-2xl bg-amber-50 p-4 text-sm leading-6 text-amber-900">Cierra el ciclo solo cuando terminó completamente la cohorte. Una venta o traslado parcial debe registrarse como movimiento y mantener el ciclo activo.</div>
        {% if form.non_field_errors() %}<div class="mt-5 rounded-2xl bg-red-50 p-4 text-sm text-red-700">{% for error in form.non_field_errors() %}<p>{{ error }}</p>{% endfor %}</div>{% endif %}
        <form method="post" class="mt-7 space-y-5" novalidate>
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
            {% for field in form %}
            <div>
                <label for="{{ field.id_for_label }}" class="text-sm font-bold text-brand-brown">{{ field.label }}</label>
                {{ field }}
                {% for error in field.errors %}<p class="mt-2 text-sm text-red-700">{{ error }}</p>{% endfor %}
            </div>
            {% endfor %}
            <div class="flex flex-col-reverse gap-3 border-t border-stone-100 pt-6 sm:flex-row sm:justify-end">
                <a href="{{ url('monitoreo:piscina_detalle', piscina_id=piscina.id) }}" class="rounded-2xl border border-stone-200 px-5 py-3 text-center font-bold text-stone-600">Cancelar</a>
                <button type="submit" class="rounded-2xl bg-brand-brown px-6 py-3 font-bold text-white">Confirmar cierre</button>
            </div>
        </form>
    </div>
</section>
{% endblock %}
